# use the Gmail address and a Google "App Password" (not the normal password).
SMTP_USER=""
SMTP_PASS=""
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# EMAIL_FROM="Aldar Restaurant <you@gmail.com>"
# RESTAURANT_TIMEZONE="Asia/Riyadh"

# Vercel Blob (optional for local dev)
BLOB_READ_WRITE_TOKEN=""
